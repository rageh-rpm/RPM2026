<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Account Journal Form View Inherit -->
    <record id="view_account_journal_form_inherit_overdraft" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.overdraft</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <!-- Add button in button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_facilities"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-university"
                        invisible="not is_overdraft_facility">
                    <field name="facility_count" widget="statinfo" string="Facilities"/>
                </button>
            </xpath>

            <!-- Add overdraft checkbox -->
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_overdraft_facility"
                       invisible="type != 'bank'"
                       string="Has Overdraft Facility"/>
            </xpath>

            <!-- Add active facility info -->
            <xpath expr="//field[@name='is_overdraft_facility']" position="after">
                <field name="active_facility_id"
                       readonly="1"
                       invisible="not is_overdraft_facility"
                       string="Active Facility"/>
            </xpath>

        </field>
    </record>

</odoo>
