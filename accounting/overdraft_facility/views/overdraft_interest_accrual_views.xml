<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Interest Accrual List View - UPDATED -->
    <record id="view_overdraft_interest_accrual_list" model="ir.ui.view">
        <field name="name">overdraft.interest.accrual.list</field>
        <field name="model">overdraft.interest.accrual</field>
        <field name="arch" type="xml">
            <list string="Interest Accruals"
                  decoration-success="state=='posted'"
                  decoration-muted="state=='cancelled'"
                  multi_edit="1">
                <header>
                    <!-- ✅ BATCH POST BUTTON -->
                    <button name="action_post_batch"
                            type="object"
                            string="Post Selected"
                            class="btn-primary"
                            invisible="context.get('active_model') != 'overdraft.interest.accrual'"/>
                </header>
                <field name="name"/>
                <field name="facility_id"/>
                <field name="payment_id"/>
                <field name="accrual_date"/>
                <field name="period_from"/>
                <field name="period_to"/>
                <field name="days_count"/>
                <field name="principal_amount" sum="Total Principal"/>
                <field name="interest_amount" sum="Total Interest"/>
                <field name="has_variable_rates" widget="boolean" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state=='posted'"
                       decoration-info="state=='draft'"
                       decoration-danger="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Interest Accrual Form View -->
    <record id="view_overdraft_interest_accrual_form" model="ir.ui.view">
        <field name="name">overdraft.interest.accrual.form</field>
        <field name="model">overdraft.interest.accrual</field>
        <field name="arch" type="xml">
            <form string="Interest Accrual">
                <header>
                    <!-- ✅ POST BUTTON -->
                    <button name="action_post"
                            string="Post Interest"
                            type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state != 'draft'"/>

                    <button name="action_set_to_draft"
                            string="Set to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>

                    <button name="action_view_journal_entry"
                            string="View Journal Entry"
                            type="object"
                            invisible="not move_id"
                            class="btn-secondary"/>

                    <button name="action_view_breakdown"
                            string="View Rate Breakdown"
                            type="object"
                            invisible="not has_variable_rates"
                            class="btn-secondary"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Reference">
                            <field name="facility_id" readonly="1"/>
                            <field name="payment_id" readonly="1"/>
                            <field name="accrual_date"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Period">
                            <field name="period_from" readonly="1"/>
                            <field name="period_to" readonly="1"/>
                            <field name="days_count" readonly="1"/>
                            <field name="has_variable_rates" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Calculation">
                            <field name="principal_amount" readonly="1" widget="monetary"/>
                            <field name="daily_rate" readonly="1"/>
                            <field name="interest_amount" readonly="1" widget="monetary" class="fw-bold"/>
                        </group>
                        <group string="Accounting">
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>

                    <!-- Rate Breakdown Section -->
                    <group string="Rate Breakdown" invisible="not period_breakdown">
                        <field name="period_breakdown" widget="text" readonly="1" nolabel="1"/>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Interest Accrual Search View -->
    <record id="view_overdraft_interest_accrual_search" model="ir.ui.view">
        <field name="name">overdraft.interest.accrual.search</field>
        <field name="model">overdraft.interest.accrual</field>
        <field name="arch" type="xml">
            <search string="Interest Accruals">
                <field name="name"/>
                <field name="facility_id"/>
                <field name="payment_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('accrual_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('accrual_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="Variable Rates" name="variable_rates" domain="[('has_variable_rates', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Facility" name="group_facility" context="{'group_by': 'facility_id'}"/>
                    <filter string="Payment" name="group_payment" context="{'group_by': 'payment_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Accrual Date" name="group_date" context="{'group_by': 'accrual_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Interest Accrual Action -->
    <record id="action_overdraft_interest_accrual" model="ir.actions.act_window">
        <field name="name">Interest Accruals</field>
        <field name="res_model">overdraft.interest.accrual</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No interest accruals yet
            </p>
            <p>
                Interest accruals are automatically created when overdraft payments are confirmed.
                Click "Post Interest" to create accounting entries.
            </p>
        </field>
    </record>

</odoo>
