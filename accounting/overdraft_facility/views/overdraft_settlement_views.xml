<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Overdraft Settlement list View -->
    <record id="view_overdraft_settlement_list" model="ir.ui.view">
        <field name="name">overdraft.settlement.list</field>
        <field name="model">overdraft.settlement</field>
        <field name="arch" type="xml">
            <list string="Overdraft Settlements" decoration-success="state=='posted'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="facility_id"/>
                <field name="settlement_date"/>
                <field name="source_journal_id"/>
                <field name="amount" sum="Total" widget="monetary"/>
                <field name="state" widget="badge" decoration-success="state=='posted'" decoration-info="state=='draft'" decoration-danger="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Overdraft Settlement Form View -->
    <record id="view_overdraft_settlement_form" model="ir.ui.view">
        <field name="name">overdraft.settlement.form</field>
        <field name="model">overdraft.settlement</field>
        <field name="arch" type="xml">
            <form string="Overdraft Settlement">
                <header>
                    <button name="action_post" string="Post Settlement" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <button name="action_set_to_draft" string="Set to Draft" type="object" invisible="state != 'cancelled'"/>
                    <button name="action_view_journal_entry" string="View Journal Entry" type="object" invisible="not move_id" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group name="settlement_info" string="Settlement Information">
                            <field name="facility_id" options="{'no_create': True}"/>
                            <field name="settlement_date"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group name="transfer_info" string="Transfer Details">
                            <field name="source_journal_id" options="{'no_create': True}"/>
                            <field name="amount" widget="monetary"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description" placeholder="Enter settlement details..." nolabel="1"/>
                    </group>

                    <group string="Journal Entry" invisible="not move_id">
                        <field name="move_id" readonly="1"/>
                    </group>

                    <notebook>
    <page string="Payment Allocations" name="allocations">
        <field name="allocation_ids"
               readonly="state != 'draft'"
               context="{'default_facility_id': facility_id}">
            <list editable="bottom">
                <field name="payment_id"
                       domain="[('overdraft_facility_id', '=', parent.facility_id), ('state', 'in', ['in_process', 'paid']), ('settlement_status', 'in', ['pending', 'partial'])]"
                       options="{'no_create': True}"/>
                <field name="facility_id" column_invisible="1"/>
                <field name="payment_name" optional="hide"/>
                <field name="payment_date" optional="show"/>
                <field name="settlement_due_date" optional="show"/>
                <field name="payment_amount" widget="monetary"/>
                <field name="payment_outstanding" widget="monetary"/>
                <field name="amount" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
        <group class="oe_subtotal_footer">
            <field name="total_allocated" widget="monetary" class="oe_subtotal_footer_separator"/>
            <field name="allocation_count" string="Payments Allocated"/>
        </group>
    </page>
</notebook>
                </sheet>
                <chatter/>

            </form>
        </field>
    </record>

    <!-- Overdraft Settlement Search View -->
    <record id="view_overdraft_settlement_search" model="ir.ui.view">
        <field name="name">overdraft.settlement.search</field>
        <field name="model">overdraft.settlement</field>
        <field name="arch" type="xml">
            <search string="Overdraft Settlements">
                <field name="name"/>
                <field name="facility_id"/>
                <field name="source_journal_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="This Month" name="this_month" domain="[('settlement_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')), ('settlement_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Facility" name="group_facility" context="{'group_by': 'facility_id'}"/>
                    <filter string="Source Journal" name="group_journal" context="{'group_by': 'source_journal_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Settlement Date" name="group_date" context="{'group_by': 'settlement_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Overdraft Settlement Action -->
    <record id="action_overdraft_settlement" model="ir.actions.act_window">
        <field name="name">Overdraft Settlements</field>
        <field name="res_model">overdraft.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Settlement
            </p>
            <p>
                Settle overdraft balances by transferring from other bank accounts.
            </p>
        </field>
    </record>

</odoo>
