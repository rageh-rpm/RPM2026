<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_treasury_request_form" model="ir.ui.view">
        <field name="name">treasury.request.form</field>
        <field name="model">treasury.request</field>
        <field name="arch" type="xml">
            <form string="Payment Request">
                <header>
                    <!-- User actions -->
                    <button name="action_submit"
                            type="object"
                            string="Submit for Approval"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <!-- Manager actions -->
                    <button name="action_manager_approve"
                            type="object"
                            string="Approve"
                            class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="treasury_request.group_treasury_manager"/>

                    <button name="action_manager_reject"
                            type="object"
                            string="Reject"
                            invisible="state != 'submitted'"
                            groups="treasury_request.group_treasury_manager"/>

                    <!-- Treasury Officer actions -->
                    <button name="action_treasury_approve"
                            type="object"
                            string="Approve for Execution"
                            class="oe_highlight"
                            invisible="state != 'manager_approved'"
                            groups="treasury_request.group_treasury_officer"/>

                    <button name="action_treasury_reject"
                            type="object"
                            string="Reject"
                            invisible="state != 'manager_approved'"
                            groups="treasury_request.group_treasury_officer"/>

                    <!-- Executive actions -->
                    <button name="action_executive_confirm"
                            type="object"
                            string="Confirm and Create Payment"
                            class="oe_highlight"
                            invisible="state != 'treasury_approved'"
                            groups="treasury_request.group_treasury_exec"/>

                    <!-- Other actions -->
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state in ['confirmed', 'cancelled', 'rejected']"/>

                    <button name="action_set_to_draft"
                            type="object"
                            string="Set to Draft"
                            invisible="state not in ['cancelled', 'rejected']"
                            groups="treasury_request.group_treasury_admin"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,manager_approved,treasury_approved,confirmed"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money"
                                invisible="not payment_id">
                            <field name="payment_state" widget="label_selection"
                                   options="{'classes': {'posted': 'success', 'draft': 'warning'}}"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group name="request_info">
                            <field name="request_type"/>
                            <field name="payment_category"/>
                            <field name="partner_id"/>
                            <field name="partner_bank_id"/>
                            <field name="scheduled_date"/>
                        </group>
                        <group name="financial_info">
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="invoice_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <group>
                        <field name="description" placeholder="Enter payment description..."/>
                    </group>

                    <notebook>
                        <page string="Approval Details">
                            <group>
                                <group string="Requester">
                                    <field name="requester_id"/>
                                    <field name="request_date"/>
                                </group>
                                <group string="Manager Approval">
                                    <field name="manager_id"/>
                                    <field name="manager_approved_by"/>
                                    <field name="manager_approved_date"/>
                                    <field name="manager_comments" invisible="not manager_comments"/>
                                </group>
                            </group>
                            <group>
                                <group string="Treasury Approval">
                                    <field name="treasury_approved_by"/>
                                    <field name="treasury_approved_date"/>
                                    <field name="treasury_comments" invisible="not treasury_comments"/>
                                </group>
<group string="Executive Confirmation"
       invisible="state not in ['treasury_approved', 'confirmed']">
    <field name="available_payment_method_line_ids" invisible="1"/>
    <field name="journal_id"
           required="state == 'treasury_approved'"
           readonly="state != 'treasury_approved'"
           groups="treasury_request.group_treasury_exec"/>
    <field name="payment_method_line_id"
           required="state == 'treasury_approved'"
           readonly="state != 'treasury_approved'"
           groups="treasury_request.group_treasury_exec"
           options="{'no_create': True, 'no_open': True}"/>
    <field name="executive_confirmed_by"/>
    <field name="executive_confirmed_date"/>
    <field name="executive_comments" invisible="not executive_comments"/>
</group>
                            </group>
                            <group invisible="state != 'rejected'">
                                <group string="Rejection Details">
                                    <field name="rejected_by"/>
                                    <field name="rejected_date"/>
                                    <field name="rejection_reason"/>
                                </group>
                            </group>
                        </page>

                        <page string="Payment Info" invisible="not payment_id">
                            <group>
                                <field name="payment_id"/>
                                <field name="payment_state"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_treasury_request_list" model="ir.ui.view">
        <field name="name">treasury.request.list</field>
        <field name="model">treasury.request</field>
        <field name="arch" type="xml">
            <list string="Payment Requests"
                  sample="1"
                  decoration-info="state == 'draft'"
                  decoration-warning="state in ['submitted', 'manager_approved', 'treasury_approved']"
                  decoration-success="state == 'confirmed'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="request_date"/>
                <field name="requester_id"/>
                <field name="partner_id"/>
                <field name="payment_category"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="scheduled_date"/>
                <field name="state"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ['submitted', 'manager_approved', 'treasury_approved']"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'rejected'"
                       widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_treasury_request_search" model="ir.ui.view">
        <field name="name">treasury.request.search</field>
        <field name="model">treasury.request</field>
        <field name="arch" type="xml">
            <search string="Payment Requests">
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Payee"/>
                <field name="requester_id" string="Requester"/>
                <field name="description"/>

                <filter string="My Requests" name="my_requests"
                        domain="[('requester_id', '=', uid)]"/>
                <filter string="My Team Requests" name="my_team"
                        domain="[('manager_id', '=', uid)]"/>

                <separator/>

                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Manager" name="pending_manager"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Pending Treasury" name="pending_treasury"
                        domain="[('state', '=', 'manager_approved')]"/>
                <filter string="Ready to Execute" name="ready_execute"
                        domain="[('state', '=', 'treasury_approved')]"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Rejected" name="rejected"
                        domain="[('state', '=', 'rejected')]"/>

                <separator/>

                <filter string="This Week" name="this_week"
                        domain="[('scheduled_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                                ('scheduled_date', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('scheduled_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d')),
                                ('scheduled_date', '&lt;=', ((context_today().replace(day=1) + datetime.timedelta(days=32)).replace(day=1) - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Requester" name="group_requester"
                            context="{'group_by': 'requester_id'}"/>
                    <filter string="Payee" name="group_payee"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'payment_category'}"/>
                    <filter string="Payment Date" name="group_scheduled_date"
                            context="{'group_by': 'scheduled_date'}"/>
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_treasury_request_kanban" model="ir.ui.view">
        <field name="name">treasury.request.kanban</field>
        <field name="model">treasury.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="scheduled_date"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-12">
                                    <strong><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-8">
                                    <field name="partner_id"/>
                                </div>
                                <div class="col-4 text-end">
                                    <field name="amount" widget="monetary"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-8">
                                    <i class="fa fa-calendar"/> <field name="scheduled_date"/>
                                </div>
                                <div class="col-4 text-end">
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-warning="state in ['submitted', 'manager_approved', 'treasury_approved']"
                                           decoration-success="state == 'confirmed'"
                                           decoration-danger="state == 'rejected'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_treasury_request" model="ir.actions.act_window">
        <field name="name">Payment Requests</field>
        <field name="res_model">treasury.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new payment request
            </p>
            <p>
                Submit payment requests for approval through the treasury workflow.
            </p>
        </field>
    </record>

    <record id="action_treasury_request_pending_manager" model="ir.actions.act_window">
        <field name="name">Pending Manager Approval</field>
        <field name="res_model">treasury.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="context">{'search_default_my_team': 1}</field>
    </record>

    <record id="action_treasury_request_pending_treasury" model="ir.actions.act_window">
        <field name="name">Pending Treasury Approval</field>
        <field name="res_model">treasury.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'manager_approved')]</field>
    </record>

    <record id="action_treasury_request_ready_execute" model="ir.actions.act_window">
        <field name="name">Ready to Execute</field>
        <field name="res_model">treasury.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', '=', 'treasury_approved')]</field>
    </record>

</odoo>
