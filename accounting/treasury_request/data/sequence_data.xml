<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for treasury requests -->
        <record id="sequence_treasury_request" model="ir.sequence">
            <field name="name">Treasury Request</field>
            <field name="code">treasury.request</field>
            <field name="prefix">TR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
