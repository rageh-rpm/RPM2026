<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Activity Type: Treasury Approval -->
        <record id="mail_activity_treasury_approval" model="mail.activity.type">
            <field name="name">Treasury Approval Required</field>
            <field name="summary">Payment Request Approval</field>
            <field name="icon">fa-money</field>
            <field name="delay_count">2</field>
            <field name="delay_unit">days</field>
        </record>

        <!-- Activity Type: Treasury Execution -->
        <record id="mail_activity_treasury_execution" model="mail.activity.type">
            <field name="name">Payment Execution Required</field>
            <field name="summary">Execute Payment</field>
            <field name="icon">fa-check-circle</field>
            <field name="delay_count">1</field>
            <field name="delay_unit">days</field>
        </record>

    </data>
</odoo>
