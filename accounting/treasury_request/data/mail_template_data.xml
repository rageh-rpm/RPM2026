<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Email Template: Manager Approval Request -->
        <record id="email_template_manager_approval" model="mail.template">
            <field name="name">Treasury: Manager Approval Request</field>
            <field name="model_id" ref="model_treasury_request"/>
            <field name="subject">Payment Request Approval Required: ${object.name}</field>
            <field name="email_from">${(object.company_id.email or user.email_formatted) | safe}</field>
            <field name="email_to">${object.manager_id.email | safe}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear ${object.manager_id.name},
                        <br/><br/>
                        A new payment request requires your approval.
                        <br/><br/>
                        <strong>Request Details:</strong><br/>
                        Request Number: ${object.name}<br/>
                        Requester: ${object.requester_id.name}<br/>
                        Payee: ${object.partner_id.name}<br/>
                        Amount: ${object.amount} ${object.currency_id.name}<br/>
                        Payment Date: ${object.scheduled_date}<br/>
                        Description: ${object.description}<br/>
                        <br/>
                        Please review and approve this request.
                        <br/><br/>
                        <a href="/web#id=${object.id}&amp;model=treasury.request&amp;view_type=form" style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                            View Request
                        </a>
                        <br/><br/>
                        Thank you,<br/>
                        ${object.company_id.name}
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
