<odoo>
    <data>
        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="biotime8_integeration.list">
            <field name="name">biotime8_integeration list</field>
            <field name="model">biotime.integeration</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <button name="rec_print" type="object" string="Print Result" class="btn-primary"/>

                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="biotime_auth_list">
            <field name="name">biotime8_integeration list</field>
            <field name="model">biotime.connection</field>
            <field name="arch" type="xml">
                <list editable="top">
                    <field name="name"/>
                    <field name="password"/>
                    <field name="auth_code"/>
                    <field name="is_active"/>
                    <button name="generate_auth" type="object" string="Auth!!!" class="btn-primary"/>

                </list>
            </field>
        </record>

        <!-- actions opening views on models -->

        <record model="ir.actions.act_window" id="biotime8_integeration_action_window">
            <field name="name">biotime8_integeration window</field>
            <field name="res_model">biotime.integeration</field>
            <field name="view_mode">list,form</field>
        </record>

        <record model="ir.actions.act_window" id="generate_auth_action_window">
            <field name="name">biotime8_integeration window</field>
            <field name="res_model">biotime.connection</field>
            <field name="view_mode">list</field>
        </record>

 <record id="res_config_settings_view_form_inherit_biotime" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.biotime</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Add Biotime Integration section -->
            <xpath expr="//form" position="inside">
                <app string="Biotime Integration" name="biotime_attendance">
                    <block title="Biotime Server Configuration">
                        <setting help="Configure connection to Biotime attendance system">
                            <field name="biotime_base_url" placeholder="http://172.20.10.11"/>
                            <div class="mt8">
                                <label for="biotime_api_timeout" class="o_light_label"/>
                                <field name="biotime_api_timeout" class="oe_inline"/>
                                <span class="o_form_label"> seconds</span>
                            </div>
                        </setting>
                    </block>

                    <block title="Shift Configuration">
                        <setting string="Day Shift Times"
                                 help="Configure default day shift working hours">
                            <div class="row">
                                <label for="day_shift_start" string="Start Time" class="col-3 o_light_label"/>
                                <field name="day_shift_start" widget="float_time" class="col-3"/>
                            </div>
                            <div class="row mt8">
                                <label for="day_shift_end" string="End Time" class="col-3 o_light_label"/>
                                <field name="day_shift_end" widget="float_time" class="col-3"/>
                            </div>
                            <div class="row mt8">
                                <label for="day_ovt_end" string="OT End Time" class="col-3 o_light_label"/>
                                <field name="day_ovt_end" widget="float_time" class="col-3"/>
                            </div>
                        </setting>

                        <setting string="Night Shift Times"
                                 help="Configure default night shift working hours">
                            <div class="row">
                                <label for="night_shift_start" string="Start Time" class="col-3 o_light_label"/>
                                <field name="night_shift_start" widget="float_time" class="col-3"/>
                            </div>
                            <div class="row mt8">
                                <label for="night_shift_end" string="End Time" class="col-3 o_light_label"/>
                                <field name="night_shift_end" widget="float_time" class="col-3"/>
                            </div>
                             <div class="row mt8">
                                <label for="timezone" string="TimeZone" class="col-3 o_light_label"/>
                                <field name="timezone" class="col-3"/>
                            </div>
                        </setting>

                        <setting string="Attendance Tolerances"
                                 help="Grace periods for late check-in and overtime">
                            <div class="row">
                                <label for="late_checkin_tolerance" string="Late Tolerance" class="col-4 o_light_label"/>
                                <field name="late_checkin_tolerance" class="col-2"/>
                                <span class="col-2 o_form_label">minutes</span>
                            </div>
                            <div class="row mt8">
                                <label for="overtime_tolerance_company" string="OT Tolerance" class="col-4 o_light_label"/>
                                <field name="overtime_tolerance_company" class="col-2"/>
                                <span class="col-2 o_form_label">minutes</span>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>

        </field>
    </record>


        <record id="view_hr_late_checkin_list" model="ir.ui.view">
            <field name="name">hr.late.checkin.list</field>
            <field name="model">hr.late.checkin</field>
            <field name="arch" type="xml">
                <list>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="late_duration"/>
                </list>
            </field>
        </record>


        <record id="action_view_late_checkins" model="ir.actions.act_window">
    <field name="name">Late Check-ins</field>
    <field name="res_model">hr.late.checkin</field>
    <field name="view_mode">list</field>
    <field name="domain">[(1, '=', 1)]</field>  <!-- Placeholder domain -->
</record>


        <record id="view_hr_late_checkin_form" model="ir.ui.view">
            <field name="name">hr.late.checkin.form</field>
            <field name="model">hr.late.checkin</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="employee_id"/>
                        <field name="date"/>
                        <field name="late_duration"/>
                    </group>
                </form>
            </field>
        </record>




        <menuitem name="BioTime" id="biotime8_integeration.menu_1_list"
                  action="biotime8_integeration_action_window"/>

        <menuitem name="Generate Auth " id="biotime_auth_generate"
                  action="generate_auth_action_window"/>

    </data>
</odoo>