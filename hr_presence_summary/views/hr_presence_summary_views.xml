<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_presence_summary_list" model="ir.ui.view">
        <field name="name">hr.presence.summary.list</field>
        <field name="model">hr.presence.summary</field>
        <field name="arch" type="xml">
            <list string="Daily Presence Summaries" decoration-info="presence_type == 'attendance'" decoration-warning="presence_type == 'time_off'" decoration-muted="presence_type in ('weekend', 'holiday')" decoration-danger="presence_type == 'absent'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="presence_type"/>
                <field name="leave_type_id" invisible="presence_type != 'time_off'"/>
                <field name="duration_display" string="Duration"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_hr_presence_summary_pivot" model="ir.ui.view">
        <field name="name">hr.presence.summary.pivot</field>
        <field name="model">hr.presence.summary</field>
        <field name="arch" type="xml">
            <pivot string="Presence Analysis">
                <field name="employee_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="presence_type" type="col"/>
                <field name="hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hr_presence_summary_search" model="ir.ui.view">
        <field name="name">hr.presence.summary.search</field>
        <field name="model">hr.presence.summary</field>
        <field name="arch" type="xml">
            <search string="Search Presence Summary">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date"/>
                <filter string="Attendance" name="attendance" domain="[('presence_type', '=', 'attendance')]"/>
                <filter string="Time Off" name="time_off" domain="[('presence_type', '=', 'time_off')]"/>
                <filter string="Absence" name="absent" domain="[('presence_type', '=', 'absent')]"/>
                <separator/>
                <filter string="This Month" name="this_month" domain="[('date', '&gt;=', context_today().strftime('%%Y-%%m-01'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'presence_type'}"/>
                    <filter string="Time Off Type" name="group_leave_type" context="{'group_by': 'leave_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_presence_summary" model="ir.actions.act_window">
        <field name="name">Daily Presence Summaries</field>
        <field name="res_model">hr.presence.summary</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_hr_presence_summary_search"/>
        <field name="context">{'search_default_group_date': 1}</field>
    </record>

    <menuitem id="menu_hr_presence_root" 
              name="Presence Summaries" 
              parent="hr.menu_hr_root" 
              sequence="90"/>

    <menuitem id="menu_hr_presence_summary" 
              name="Daily Summaries" 
              parent="menu_hr_presence_root" 
              action="action_hr_presence_summary" 
              sequence="10"/>

    <menuitem id="menu_hr_presence_generate" 
              name="Generate Summaries" 
              parent="menu_hr_presence_root" 
              action="action_hr_presence_summary_wizard" 
              sequence="20"/>
</odoo>
